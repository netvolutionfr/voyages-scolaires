# Développement local : remplacer les mots de passe et remplir les clés/SMTP.
# Spring Boot ne charge pas ce fichier : exporter les variables ou utiliser EnvFile.
SPRING_APPLICATION_NAME=voyages
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL : garder les valeurs Compose et Spring cohérentes.
DB_NAME=voyages
DB_USER=voyages
DB_PASSWORD=changeit-local
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/voyages
SPRING_DATASOURCE_USERNAME=voyages
SPRING_DATASOURCE_PASSWORD=changeit-local
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
# DLL est le nom actuellement lu par application.properties ; Flyway gère le schéma.
SPRING_JPA_HIBERNATE_DLL_AUTO=validate
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=http://localhost:8080
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_SECURITY=INFO
APP_FRONTEND_URL=http://localhost:5173

# S3 / MinIO : garder les identifiants cohérents.
S3_BUCKET=voyages
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_PRESIGN_MIN=10
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeit-local
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=changeit-local

ACTIVATION_ISSUER=campusaway
ACTIVATION_EXPIRY_MINUTES=30
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM='Campus Away <sender@example.com>'
SMTP_USER=smtp-user
SMTP_PASS=smtp-pass

# RP ID : nom d'hôte seul, sans https:// ni chemin.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME='Campus Away'
WEBAUTHN_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
WEBAUTHN_DEFAULT_ORIGIN=http://localhost:5173
WEBAUTHN_CHALLENGE_TTL_SECONDS=300

# Remplir les clés PEM EC P-256 (PKCS8 privée / SPKI publique).
# Les retours à la ligne peuvent être représentés par des \n littéraux.
# Voir CLAUDE.md pour la génération des clés ; ne jamais commiter de clés réelles.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=http://localhost:8080
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
JWT_PENDING_TTL_SECONDS=600
OTP_TTL_SECONDS=600
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_RESEND_QUOTA_COUNT=3
OTP_RESEND_QUOTA_WINDOW_MINUTES=15

# Générer deux clés distinctes avec openssl rand -base64 32.
DATA_ENCRYPTION_KEY=
CRYPTO_KEK_B64=

# HTTP local uniquement ; COOKIE_SECURE=true sur un hébergement HTTPS.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
COOKIE_DOMAIN=
